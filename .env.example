# Supabase Configuration
# Replace these with your real Supabase project credentials if connecting to live Supabase backend.
# The application automatically falls back to an intelligent, persistent local storage relational database
# if these variables are unset or use demo placeholders.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

